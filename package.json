  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.38",
    "sharp": "^0.33.5",
    "tailwindcss": "3.4.4",
    "vite": "^5.4.11",
    "wrangler": "^4.0.0"
  }
